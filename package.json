{
  "name": "perfections-recruitment",
  "version": "3.0.0",
  "description": "Perfections Recruitment Agency - Complete System with Telegram Bot, WhatsApp Chat, Job Alerts, Real-time Notifications, and JSONBin.io Storage",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "prod": "NODE_ENV=production node server.js",
    "pm2": "pm2 start server.js --name perfections",
    "pm2:stop": "pm2 stop perfections",
    "pm2:restart": "pm2 restart perfections",
    "pm2:logs": "pm2 logs perfections",
    "pm2:monit": "pm2 monit",
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,json}\"",
    "jobs:update": "node scripts/update-jobs.js",
    "alerts:send": "node scripts/send-alerts.js",
    "fix:jobs": "node scripts/fix-jobs.js"
  },
  "engines": {
    "node": "18.x",
    "npm": "9.x"
  },
  "keywords": [
    "recruitment",
    "jobs",
    "uk",
    "chat",
    "telegram-bot",
    "whatsapp-clone",
    "websocket",
    "real-time",
    "job-search",
    "ntfy",
    "notifications",
    "jsonbin",
    "cloud-storage",
    "payment-types",
    "hourly-jobs",
    "daily-jobs",
    "weekly-jobs",
    "monthly-jobs",
    "yearly-jobs",
    "full-time",
    "part-time",
    "contract",
    "job-alerts",
    "automated-notifications",
    "admin-panel",
    "user-management",
    "application-tracking",
    "address-autocomplete",
    "file-upload",
    "image-upload",
    "cron-jobs",
    "scheduled-tasks"
  ],
  "author": {
    "name": "Perfections Recruitment Agency Ltd",
    "email": "info@perfectionsrecruitmentagency.com",
    "url": "https://perfectionsrecruitmentagency.com"
  },
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/perfections-recruitment/website.git"
  },
  "bugs": {
    "url": "https://github.com/perfections-recruitment/website/issues"
  },
  "homepage": "https://perfectionsrecruitmentagency.com",
  "dependencies": {
    "axios": "^1.6.2",
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.20.2",
    "bull": "^4.11.5",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-session": "^1.17.3",
    "fs-extra": "^11.1.1",
    "helmet": "^7.0.0",
    "ioredis": "^5.3.2",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.17.21",
    "moment": "^2.29.4",
    "moment-timezone": "^0.5.43",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "node-fetch": "^2.7.0",
    "node-telegram-bot-api": "^0.64.0",
    "nodemailer": "^6.9.7",
    "otp-generator": "^4.0.1",
    "pm2": "^5.3.0",
    "qr-image": "^3.2.0",
    "rate-limit-flexible": "^2.4.1",
    "sharp": "^0.33.0",
    "socket.io": "^4.7.2",
    "socket.io-client": "^4.7.2",
    "speakeasy": "^2.0.0",
    "uuid": "^9.0.1",
    "validator": "^13.11.0",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^4.7.1",
    "ws": "^8.14.2",
    "xss": "^1.0.14"
  },
  "devDependencies": {
    "@types/node": "^20.10.5",
    "eslint": "^8.56.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.29.1",
    "nodemon": "^3.0.1",
    "prettier": "^3.1.1"
  },
  "optionalDependencies": {
    "bufferutil": "^4.0.8",
    "utf-8-validate": "^6.0.3"
  },
  "nodemonConfig": {
    "ignore": [
      "data/*",
      "logs/*",
      "node_modules/*",
      "uploads/*"
    ],
    "watch": [
      "server.js",
      "public/",
      "scripts/"
    ],
    "ext": "js,json,html,css",
    "env": {
      "NODE_ENV": "development"
    },
    "delay": "1000"
  }
}
